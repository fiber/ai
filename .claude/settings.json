{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "go build -o .claude/gate-bin ./cmd/gate || exit 2; exec .claude/gate-bin hook",
            "timeout": 60,
            "statusMessage": "process gate"
          }
        ]
      }
    ]
  }
}
