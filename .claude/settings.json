{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "go run ./cmd/gate hook",
            "timeout": 30,
            "statusMessage": "process gate"
          }
        ]
      }
    ]
  }
}
